<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>gl2gh</AssemblyName>
    <RootNamespace>GitLabToGitHub</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <NoWarn>$(NoWarn);CA1031;CA1054;CA1056;CA1515;CS8600;CS8602;CS8603;CS8604;NU1507</NoWarn>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GitHub.Migration" />
    <PackageReference Include="Octoshift" />
    <PackageReference Include="Octoshift.Extensions" />
  </ItemGroup>

</Project>
